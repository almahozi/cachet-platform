#!/bin/bash
# Install docker and compose
yum update -y
amazon-linux-extras install docker -y
service docker start
usermod -a -G docker ec2-user

# Pull the Docker Compose file (we'll manage this via CI/CD later)
mkdir -p /opt/cachet
# ... (commands to create or pull your docker-compose.yml) ...

# Run the app
cd /opt/cachet
docker-compose up -d
